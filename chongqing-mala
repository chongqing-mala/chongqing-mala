<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>ฉงชิ่งหม่าล่าทอด - สั่งอาหารออนไลน์</title>
  <style>
    html, body {
      background: #F4F6F8;
      color: #1C1C1C;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-user-select: none;
      user-select: none;
    }
    .shield-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-size: 14px;
      font-weight: 600;
      color: #00B14F;
      gap: 12px;
    }
    .shield-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E2E8F0;
      border-top-color: #00B14F;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
  <script>
    /* =========================================================================
       ระบบป้องกันโค้ด & ป้องกันการกด F12 / Inspect (Chongqing Mala Security Shield)
       ========================================================================= */
    (function() {
      window.__INITIAL_VIEW_PARAM = "customer";
      window.__SERVER_WEBAPP_URL = "https://script.google.com/macros/s/AKfycbybIMioJOWDk1ZKjC1a9EseOjzFbyJZDBiYsSI4eE8jJaqsGcREkU8QfLcZ73anCAOVyQ/exec";

      // 1. ป้องกันการคลิกขวา (Disable Right-Click)
      document.addEventListener("contextmenu", function(e) {
        e.preventDefault();
        return false;
      }, true);

      // 2. ป้องกันปุ่มลัด DevTools / F12 / Inspect / View Source
      document.addEventListener("keydown", function(e) {
        var k = e.keyCode || e.which;
        // F12
        if (k === 123) { e.preventDefault(); e.stopPropagation(); return false; }
        // Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+Shift+C
        if (e.ctrlKey && e.shiftKey && (k === 73 || k === 74 || k === 67)) {
          e.preventDefault(); e.stopPropagation(); return false;
        }
        // Cmd+Alt+I (Mac)
        if (e.metaKey && e.altKey && (k === 73 || k === 74 || k === 67)) {
          e.preventDefault(); e.stopPropagation(); return false;
        }
        // Ctrl+U (View Source) or Ctrl+S (Save)
        if ((e.ctrlKey || e.metaKey) && (k === 85 || k === 83)) {
          e.preventDefault(); e.stopPropagation(); return false;
        }
      }, true);

      // 3. ถอดรหัสและรันหน้าร้านค้าเฉพาะโหมดลูกค้า (ซ่อนหลังบ้าน 100%)
      var _payload = "";
      function renderApp() {
        try {
          var binary = atob(_payload);
          var bytes = new Uint8Array(binary.length);
          for (var i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i);
          }
          var decoded = new TextDecoder("utf-8").decode(bytes);
          var lockCss = "<style id=\"ServerCustomerLockStyle\">#TopAdminHeader,#TopAdminSubBar,#CustomerStandaloneExitBar,#CustomerAdminPreviewBar,#SectionPos,#SectionQueue,#SectionAdmin,#SectionLine{display:none!important;}#SectionCustomer{display:block!important;}</style>";
          document.open();
          document.write(lockCss + decoded);
          document.close();
        } catch(err) {
          console.error("Boot error:", err);
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", renderApp);
      } else {
        renderApp();
      }
    })();
  </script>
</head>
<body>
  <div class="shield-loading">
    <div class="shield-spinner"></div>
    <div>กำลังโหลดระบบสั่งอาหาร ฉงชิ่งหม่าล่าทอด...</div>
  </div>
</body>
</html>
